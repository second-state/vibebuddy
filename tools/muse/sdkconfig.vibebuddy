# Loaded last, after Muse's own sdkconfig.defaults, devices/sdkconfig.muse and
# devices/sdkconfig.muse-atk-dnesp32s3-box. It changes only where Muse sits in flash, so that it lives next to
# Vibe Buddy (firmware/partitions.csv). build.sh adds the path of partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_OFFSET=0xc14000
