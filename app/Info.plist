<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleLocalizations</key><array><string>en</string><string>zh-Hans</string><string>zh-Hant</string></array>
    <key>CFBundleDisplayName</key><string>Vibe Buddy</string>
    <key>CFBundleExecutable</key><string>VibeBuddy</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleIdentifier</key><string>com.vibebuddy.app</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>Vibe Buddy</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>__VERSION__</string>
    <key>CFBundleVersion</key><string>__BUILD__</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>LSUIElement</key><true/>
    <!-- Shown in the Automation prompt: the Agents tab asks for Ghostty, and the daemon's AppleScript counts as this app. -->
    <key>NSAppleEventsUsageDescription</key><string>Vibe Buddy uses this to take K2 to the terminal tab your agent session runs in.</string>
    <key>NSHumanReadableCopyright</key><string>Licensed under GPL-3.0-or-later</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <!-- Sparkle (ADR-0010): the key the appcast's downloads are signed with; build-app.sh fills it in from
         app/sparkle-key.pub, or drops it, and then Sparkle stays off. Checks follow the daemon's switch, and nothing
         is installed without the user: no automatic download-and-install, no permission prompt of Sparkle's own. -->
    <key>SUPublicEDKey</key><string>__SPARKLE_KEY__</string>
    <key>SUEnableAutomaticChecks</key><false/>
    <key>SUAllowsAutomaticUpdates</key><false/>
    <key>SUAutomaticallyUpdate</key><false/>
</dict>
</plist>
