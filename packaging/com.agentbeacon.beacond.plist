<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentbeacon.beacond</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/dragon/workspace/agent-beacon/target/release/beacond</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/dragon/workspace/agent-beacon</string>
  <!-- launchd 只给一个很短的 PATH，CI 轮询要用的 gh 不在里面。 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/dragon/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>2</integer>
  <key>StandardOutPath</key>
  <string>/Users/dragon/Library/Logs/AgentBeacon/beacond.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dragon/Library/Logs/AgentBeacon/beacond.log</string>
</dict>
</plist>
