CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# DIO at 40 MHz, as the espflash bootloader this replaces.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../firmware/partitions.csv"
# A new image that doesn't confirm itself on its first boot is rolled back to the previous slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
