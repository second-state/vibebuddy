CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# The cache is off while writing flash; a UART interrupt not in IRAM stalls and drops bytes.
CONFIG_UART_ISR_IN_IRAM=y
# The main task runs serial line parsing, voice pack writes and all the drawing,
# and the UART interrupt fires on its stack; the default 3584 bytes overflowed
# and rebooted during audio init.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
